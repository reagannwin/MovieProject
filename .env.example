# Copy this file to .env.local and fill in your values.
# .env.local is gitignored, so your keys stay out of the repo.

# Required. TMDB "API Read Access Token" (the long v4 token, not the short v3 key).
# Get it at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Optional. Powers the "Trending Searches" row. Leave blank to skip it.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_TABLE_ID=
